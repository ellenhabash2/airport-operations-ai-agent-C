# ---------- Database ----------
POSTGRES_DB=aeromind
POSTGRES_USER=aeromind_user
POSTGRES_PASSWORD=replace_with_a_database_password

# Used by the backend. Inside Docker, DB_HOST must be "postgres" (the service name).
# For a local run outside Docker, use "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aeromind
DB_USER=aeromind_user
DB_PASSWORD=replace_with_a_database_password

# ---------- Server ----------
PORT=8848

# Number of pooled PostgreSQL connections.
DB_POOL_SIZE=10

# Number of complete conversation turns replayed to the agent (1-100).
AGENT_HISTORY_MAX_TURNS=30

# ---------- AI provider (Gemini, OpenAI-compatible API) ----------
# Create a key in Google AI Studio. Availability and quotas depend on the
# Google project associated with the key.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ---------- Auth ----------
# REQUIRED. Used to sign JWT tokens (HS256).
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
